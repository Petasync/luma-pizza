{
  "env": {
    "SECURITY_REVIEW_MODEL": "claude-sonnet-4-6",
    "SG_AGENTIC_MODEL": "claude-sonnet-4-6"
  },
  "permissions": {
    "deny": [
      "Edit(.env)",
      "Write(.env)",
      "Edit(.env.*)",
      "Write(.env.*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/nach-edit-check.js",
            "asyncRewake": true,
            "timeout": 300,
            "statusMessage": "Typecheck+Lint läuft…"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "security-guidance@claude-plugins-official": true
  }
}
