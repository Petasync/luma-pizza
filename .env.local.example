# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxxx
SUPABASE_SERVICE_ROLE_KEY=xxxx

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxx
STRIPE_SECRET_KEY=sk_test_xxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxx

# PayPal
NEXT_PUBLIC_PAYPAL_CLIENT_ID=xxxx
PAYPAL_CLIENT_SECRET=xxxx
# "live" oder "sandbox" (Standard: sandbox)
PAYPAL_MODE=sandbox
# Webhook-ID aus dem PayPal-Entwickler-Dashboard (siehe docs/ZAHLUNG-ABSICHERUNG.md).
# Ohne diesen Wert lehnt /api/paypal/webhook jedes Event ab.
PAYPAL_WEBHOOK_ID=xxxx

# Resend
RESEND_API_KEY=re_xxxx
RESTAURANT_EMAIL=info@luma-pizza.de

# Admin
ADMIN_PASSWORD=changeme123
# Geräte-Token für den Kiosk-Laptop (Auto-Login). Lange Zufallszeichenkette,
# getrennt vom Passwort. Erzeugen z. B. mit: openssl rand -hex 24
DASHBOARD_DEVICE_TOKEN=changeme-device-token

# Nächtliche Nachtwache (Vercel-Cron, siehe vercel.json)
# Ohne diesen Wert lehnt /api/cron/nachtwache jeden Aufruf ab.
# Erzeugen z. B. mit: openssl rand -hex 32
CRON_SECRET=changeme-cron-secret

# Optional: Empfänger für technische Alarme (Zahlung ohne Bestellung,
# Datenbank nicht erreichbar). Mehrere Adressen kommagetrennt.
# Fehlt der Wert, gehen die Alarme an RESTAURANT_EMAIL.
# ALARM_EMAIL=phillipscheiderer@gmail.com

# App
NEXT_PUBLIC_BASE_URL=http://localhost:3000
